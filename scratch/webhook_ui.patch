+// ── Webhooks ──────────────────────────────────────────────────────────
+async function loadWebhooks() {
+  try {
+    const res = await apiCall('/api/v1/webhooks');
+    const tbody = document.querySelector('#webhooks-table tbody');
+    tbody.innerHTML = '';
+    if(!res || res.length===0) {
+      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted)">No webhooks registered.</td></tr>';
+      return;
+    }
+    res.forEach(w => {
+      let badgeClass = 'bg-success';
+      if(w.last_delivery_status >= 400 || w.last_delivery_status === -1) badgeClass = 'bg-danger';
+      if(!w.last_delivery_status) badgeClass = 'bg-secondary';
+      
+      let evts = (w.events || []).map(e => '<span class="badge bg-secondary">' + e + '</span>').join(' ');
+      let tr = document.createElement('tr');
+      tr.innerHTML = `
+        <td style="font-family:monospace; font-size:0.85rem">${w.id.split('-')[0]}</td>
+        <td>${w.url}</td>
+        <td>${evts}</td>
+        <td><span class="badge ${badgeClass}">${w.last_delivery_status ? (w.last_delivery_status === -1 ? 'failed' : w.last_delivery_status) : 'none'}</span></td>
+        <td>${fmtTime(w.created_at)}</td>
+        <td style="text-align:right">
+          <button class="btn btn-danger" style="padding:0.25rem 0.5rem" onclick="deleteWebhook('${w.id}')"><i class="fas fa-trash"></i></button>
+        </td>
+      `;
+      tbody.appendChild(tr);
+    });
+  } catch(e) {
+    showToast('Failed to load webhooks: ' + e.message, 'error');
+  }
+}
+
+async function registerWebhook() {
+  const url = document.getElementById('webhook-url').value;
+  const secret = document.getElementById('webhook-secret').value;
+  const checkboxes = document.querySelectorAll('input[name="webhook-events"]:checked');
+  const events = Array.from(checkboxes).map(cb => cb.value);
+  
+  if(!url) return;
+  if(events.length === 0) {
+    showToast('Please select at least one event type.', 'error');
+    return;
+  }
+  
+  try {
+    await apiCall('/api/v1/webhooks', {
+      method: 'POST',
+      body: JSON.stringify({ url, secret, events })
+    });
+    showToast('Webhook registered successfully!', 'success');
+    document.getElementById('webhook-url').value = '';
+    document.getElementById('webhook-secret').value = '';
+    loadWebhooks();
+  } catch(e) {
+    showToast('Failed to register webhook: ' + e.message, 'error');
+  }
+}
+
+async function deleteWebhook(id) {
+  if(!confirm('Are you sure you want to delete this webhook?')) return;
+  try {
+    const res = await fetch('/api/v1/webhooks/' + id, {
+      method: 'DELETE',
+      headers: { 'Authorization': 'Bearer ' + getApiKey() }
+    });
+    if(!res.ok) {
+      throw new Error(await res.text());
+    }
+    showToast('Webhook deleted', 'success');
+    loadWebhooks();
+  } catch(e) {
+    showToast('Failed to delete webhook: ' + e.message, 'error');
+  }
+}
